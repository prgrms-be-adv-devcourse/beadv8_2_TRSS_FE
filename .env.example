# 배포 환경에서 백엔드 주소. 개발 중에는 비워 두면 Vite 프록시를 써요 (npm run dev → 개발 서버, npm run dev:local → localhost:8080).
VITE_API_URL=

# 토스 결제위젯 클라이언트 키
VITE_TOSS_CLIENT_KEY=

# 카카오 REST API 키 (인가 화면 주소에 들어가는 공개 값, 백엔드 KAKAO_CLIENT_ID와 같은 값). 비어 있으면 카카오 버튼이 동작하지 않아요.
# .env는 Git에 올라가 있으니 카카오 값은 Git에서 제외되는 .env.local에 넣어요. 배포 빌드는 저장소 Variables(KAKAO_REST_API_KEY)에서 넣어요.
VITE_KAKAO_REST_API_KEY=
# 카카오 콜백 주소. 백엔드 KAKAO_REDIRECT_URI·카카오 개발자 콘솔 등록 주소와 같아야 해요. 비워 두면 지금 주소 기준 /oauth/kakao/callback
# 로컬 테스트: http://localhost:5173/oauth/kakao/callback (백엔드 KAKAO_REDIRECT_URI도 같은 값으로)
VITE_KAKAO_REDIRECT_URI=
